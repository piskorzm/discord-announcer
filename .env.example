# Required — Discord bot token (Developer Portal → your app → Bot → Reset Token)
DISCORD_TOKEN=

# Optional — extra Discord user IDs allowed to use /add-sound "for-user" (comma-separated)
# ADD_SOUND_DELEGATE_USER_IDS=

# Optional — force a specific yt-dlp executable instead of the bot-managed copy in bin/
# YTDLP_BINARY_PATH=

# Required on 32-bit ARM when the native yt-dlp binary does not run (zipapp mode).
# Full path to Python >= yt-dlp’s minimum (often 3.11+), e.g. from `uv python install 3.12`:
# YTDLP_PYTHON=/home/pi/.local/bin/python3.12
